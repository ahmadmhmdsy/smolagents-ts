{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    // The base tsconfig maps @smolagents-ts/core to its source, so this project
    // typechecks core's files too. rootDir has to contain them; noEmit means it
    // emits nothing anyway.
    "rootDir": "../..",
    "paths": {
      "@smolagents-ts/core": ["../core/src/index.ts"],
      "@smolagents-ts/models": ["../models/src/index.ts"],
      "@smolagents-ts/tools": ["../tools/src/index.ts"],
      "@smolagents-ts/exec-quickjs": ["../exec-quickjs/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
