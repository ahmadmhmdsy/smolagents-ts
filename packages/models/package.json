{
  "name": "@smolagents-ts/models",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Provider adapters behind the core's Model interface: OpenAI-compatible, Anthropic, Gemini, Hugging Face and a model defined by functions.",
  "keywords": [
    "smolagents",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "huggingface"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadmhmdsy/smolagents-ts.git",
    "directory": "packages/models"
  },
  "homepage": "https://github.com/ahmadmhmdsy/smolagents-ts#readme",
  "bugs": {
    "url": "https://github.com/ahmadmhmdsy/smolagents-ts/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepack": "node ../../scripts/copy-licence.mjs copy .",
    "postpack": "node ../../scripts/copy-licence.mjs clean ."
  },
  "dependencies": {
    "@smolagents-ts/core": "workspace:*",
    "zod": "^4.0.0"
  }
}
