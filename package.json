{
  "name": "smolagents-ts-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "vitest run --project core packages/core/test/architecture",
    "example:node": "pnpm --filter smolagents-ts build && node examples/node-script/index.mjs",
    "lint": "eslint .",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "changeset": "changeset",
    "publint": "pnpm -r --filter ./packages/* exec publint",
    "attw": "pnpm -r --filter ./packages/* exec attw --pack . --profile esm-only",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "ci:check": "node scripts/check-ci.mjs",
    "gate": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test && pnpm build && pnpm publint && pnpm attw && pnpm ci:check && pnpm pack:smoke"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.0.0",
    "publint": "^0.3.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
