node_modules/
dist/
coverage/
*.tsbuildinfo
.vitest/
.DS_Store
*.log
# reference-only clones; never committed, never built
smolagents/
reference/
# context-pack local state (locks, atomic writes, python caches)
docs/.locks/
# harness local state (session handoff archives, scratch commit messages)
.dsh/
.superpowers/
*.tmp
.pytest_cache/

# Python bytecode from the context-pack scripts
__pycache__/
*.pyc

# Generated by the docs site build (apps/docs-site)
apps/docs-site/site/

# Generated by scripts/copy-licence.mjs during pack
packages/*/LICENSE
packages/*/NOTICE

# Local secrets (API keys). Never committed; the key is read from the environment.
.env
.env.*
!.env.example

# Installed agent-skill bundles: third-party tooling, not pack surface. Kept local,
# never committed - they carry vendored browser JavaScript and a windows-x64
# executable. The pointer adapters (.cursor/rules/pack.mdc and
# .github/copilot-instructions.md) are files and stay tracked.
.cursor/agents/
.cursor/hooks.json
.cursor/skills/
.github/agents/
.github/hooks/
.github/skills/
.claude/handoffs/
