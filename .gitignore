node_modules/
dist/
coverage/
*.tsbuildinfo
.vitest/
.DS_Store
*.log
# reference-only clones; never committed, never built
smolagents/
reference/
# context-pack local state (locks, atomic writes, python caches)
docs/.locks/
# harness local state (session handoff archives, scratch commit messages)
.dsh/
*.tmp
.pytest_cache/

# Python bytecode from the context-pack scripts
__pycache__/
*.pyc

# Generated by the docs site build (apps/docs-site)
apps/docs-site/site/

# Generated by scripts/copy-licence.mjs during pack
packages/*/LICENSE
packages/*/NOTICE

# Local secrets (API keys). Never committed; the key is read from the environment.
.env
.env.*
!.env.example
